{% liquid
  assign collection = nil
  if section.settings.collection_handle != blank
    assign collection = collections[section.settings.collection_handle]
  endif
  if collection == blank and section.settings.collection != blank and section.settings.collection.id
    assign collection = section.settings.collection
  endif
%}
{% if collection != blank %}
  <section class="jewelry-store page-width" aria-label="{{ section.settings.heading | escape }}">
    <div class="container">
      <h3 class="jewelry-store__section-title">
        {% if section.settings.title_link != blank %}
          <a href="{{ section.settings.title_link }}">{{ section.settings.heading }}</a>
        {% else %}
          <a href="{{ collection.url }}">{{ section.settings.heading }}</a>
        {% endif %}
      </h3>
      <div class="jewelry-store__carousel">
        <button type="button" class="jewelry-store__nav jewelry-store__nav--prev" aria-label="הקודם">‹</button>
        <div class="jewelry-store__grid jewelry-store__grid--carousel js-store-carousel" role="list">
          {% for product in collection.products limit: section.settings.limit %}
            <article class="jewelry-store__item" role="listitem">
              <div class="jewelry-store__media">
                <a href="{{ product.url }}">
                  {% if product.featured_image %}
                    {{
                      product.featured_image
                      | image_url: width: 600
                      | image_tag: class: 'jewelry-store__img', loading: 'lazy', alt: product.featured_image.alt
                    }}
                  {% endif %}
                  <div class="jewelry-store__meta" aria-hidden="true">
                    <span class="jewelry-store__price">{% render 'oda-money-ils', cents: product.price %}</span>
                  </div>
                </a>
              </div>
              <div class="jewelry-store__body">
                <span class="jewelry-store__label">{{ product.title }}</span>
                <div class="jewelry-store__actions">
                  {% form 'product', product, class: 'oda-product-form' %}
                    <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                    <button type="submit" name="add" class="jewelry-store__add">הוספה לסל</button>
                  {% endform %}
                  {% comment %}
                    לקניה: POST ל־/cart/add + return_to לסל — לא קישור /cart/variant:qty (נוטה לפתוח תשלום מהיר PayPal וכו').
                    ללא name="add" על הכפתור — כדי שלא ייחשב כ־dynamic checkout.
                  {% endcomment %}
                  {% assign oda_go_cart_form_id = 'oda-go-cart-' | append: product.id %}
                  {% form 'product', product, class: 'oda-go-cart-form', id: oda_go_cart_form_id %}
                    <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                    <input type="hidden" name="quantity" value="1">
                    <input type="hidden" name="return_to" value="{{ routes.cart_url }}">
                    <button type="submit" class="jewelry-store__details">לקניה</button>
                  {% endform %}
                </div>
              </div>
            </article>
          {% endfor %}
        </div>
        <button type="button" class="jewelry-store__nav jewelry-store__nav--next" aria-label="הבא">›</button>
      </div>
    </div>
  </section>
{% endif %}

{% stylesheet %}
  form.oda-go-cart-form {
    display: contents;
  }
  form.oda-go-cart-form .jewelry-store__details {
    font: inherit;
    cursor: pointer;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "אוסף מוצרים (קרוסלה)",
  "settings": [
    { "type": "text", "id": "heading", "label": "כותרת", "default": "תכשיטי קריסטלים" },
    { "type": "url", "id": "title_link", "label": "קישור בכותרת (אופציונלי)" },
    {
      "type": "text",
      "id": "collection_handle",
      "label": "מזהה אוסף (handle)",
      "default": "taphtim",
      "info": "חובה בקובץ index.json — למשל taphtim, avne-crystal, misgarot"
    },
    { "type": "collection", "id": "collection", "label": "או בחר אוסף (בעורך התבנית)" },
    { "type": "range", "id": "limit", "min": 4, "max": 24, "step": 1, "default": 12, "label": "מספר מוצרים" }
  ],
  "presets": [{ "name": "אוסף מוצרים" }]
}
{% endschema %}
