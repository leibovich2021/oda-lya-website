<header>
  <div class="container">
    <nav>
      <a href="{{ routes.root_url }}" class="logo">{{ section.settings.logo_text }}</a>
      <button type="button" class="menu-toggle" aria-expanded="false" aria-controls="oda-main-menu">☰</button>
      <ul class="menu" id="oda-main-menu">
        {% if section.settings.menu != blank %}
          {% for link in linklists[section.settings.menu].links %}
            <li>
              <a href="{{ link.url }}" {% if link.active %}class="active"{% endif %}>{{ link.title }}</a>
            </li>
          {% endfor %}
        {% else %}
          {% liquid
            assign url_names = '/pages/names'
            if pages.names != blank
              assign url_names = pages.names.url
            endif
            assign url_about = '/pages/about'
            if pages.about != blank
              assign url_about = pages.about.url
            endif
            assign url_contact = '/pages/contact'
            if pages.contact != blank
              assign url_contact = pages.contact.url
            endif
            assign url_crystals = '/pages/crystals'
            if pages.crystals != blank
              assign url_crystals = pages.crystals.url
            endif
          %}
          <li><a href="{{ routes.root_url }}">דף הבית</a></li>
          <li><a href="{{ routes.all_products_collection_url }}">חנות</a></li>
          <li><a href="/collections/misgarot">הזמנות</a></li>
          <li><a href="{{ url_crystals }}">ריפוי בקריסטלים</a></li>
          <li><a href="{{ url_names }}">פענוח שמות</a></li>
          <li><a href="{{ url_about }}">אודות</a></li>
          <li><a href="{{ url_contact }}">צור קשר</a></li>
        {% endif %}
        <li class="js-oda-cart-nav-item">
          <a href="{{ routes.cart_url }}" class="cart-link" aria-label="סל קניות">
            סל <span class="cart-badge" aria-hidden="true" style="display:inline-flex">{{ cart.item_count }}</span>
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

{% schema %}
{
  "name": "כותרת עליונה",
  "settings": [
    {
      "type": "text",
      "id": "logo_text",
      "label": "טקסט לוגו",
      "default": "לְהָאִיר אֶת הַחוֹשֶׁךְ"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "תפריט ניווט"
    }
  ]
}
{% endschema %}
