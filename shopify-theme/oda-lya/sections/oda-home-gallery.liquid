{% if section.blocks.size > 0 %}
  <div class="image-gallery-section page-width">
    <div class="container">
      {% if section.settings.heading != blank %}
        <div class="gallery-title">
          <h2 class="gallery-heading">{{ section.settings.heading }}</h2>
        </div>
      {% endif %}
      <div class="simple-gallery">
        {% for block in section.blocks %}
          {% if block.settings.image != blank %}
            <div class="gallery-item" {{ block.shopify_attributes }}>
              {{
                block.settings.image
                | image_url: width: 900
                | image_tag: class: 'gallery-image-simple', loading: 'lazy', alt: block.settings.alt
              }}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "דף הבית — גלריה",
  "settings": [
    { "type": "text", "id": "heading", "label": "כותרת", "default": "מסגרות בעבודה אישית" }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "תמונה",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "תמונה" },
        { "type": "text", "id": "alt", "label": "תיאור", "default": "מסגרת בעבודת יד" }
      ]
    }
  ],
  "presets": [{ "name": "גלריית תמונות", "blocks": [{ "type": "image" }, { "type": "image" }, { "type": "image" }] }]
}
{% endschema %}
