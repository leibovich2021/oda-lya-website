<section class="hero names-hero">
  <div class="container">
    <div class="hero-content">
      <h1>{{ section.settings.hero_title }}</h1>
      <div class="intro-separator names-separator"></div>
      <p class="names-hero-text">{{ section.settings.hero_text }}</p>
    </div>
  </div>
</section>

<section id="name-meaning">
  <div class="container">
    <div class="section-title">
      <h2>{{ section.settings.intro_title }}</h2>
    </div>
    <div class="content-box names-intro-box">
      <p>{{ section.settings.intro_p }}</p>
      <div class="names-quote">
        <blockquote>{{ section.settings.intro_quote }}</blockquote>
      </div>
    </div>
  </div>
</section>

<section id="name-analysis" class="names-analysis-section">
  <div class="container">
    <div class="section-title">
      <h2>{{ section.settings.form_title }}</h2>
    </div>
    <div class="name-form analysis-form">
      <div class="form-group">
        <label for="oda-name-input">{{ section.settings.form_label }}</label>
        <input type="text" id="oda-name-input" placeholder="{{ section.settings.form_placeholder }}">
      </div>
      <button type="button" class="btn name-analysis-btn" id="oda-analyze-name-btn">{{ section.settings.form_btn }}</button>
    </div>
  </div>
</section>

<section id="name-components" class="components-section">
  <div class="container">
    <div class="section-title">
      <h2>{{ section.settings.comp_title }}</h2>
    </div>
    <div class="cards analysis-cards">
      {% for block in section.blocks %}
        {% if block.type == 'item' %}
          <div class="card analysis-card" {{ block.shopify_attributes }}>
            <div class="card-content">
              <h3>{{ block.settings.title }}</h3>
              <p>{{ block.settings.text }}</p>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var btn = document.getElementById('oda-analyze-name-btn');
    var input = document.getElementById('oda-name-input');
    if (!btn || !input) return;
    var phone = {{ section.settings.wa_phone | json }};
    var msgWith = {{ section.settings.wa_msg_with_name | json }};
    btn.addEventListener('click', function () {
      var name = (input.value || '').trim();
      if (!name) {
        alert('אנא הזן שם לפיענוח');
        return;
      }
      var raw = (msgWith || '').split('{name}').join(name);
      var msg = encodeURIComponent(raw);
      window.open('https://wa.me/' + phone + '?text=' + msg, '_blank', 'noopener,noreferrer');
    });
  });
</script>

{% schema %}
{
  "name": "עמוד פיענוח שמות",
  "settings": [
    { "type": "text", "id": "hero_title", "default": "פִּעֲנוּחַ שֵׁמוֹת", "label": "כותרת" },
    {
      "type": "text",
      "id": "hero_text",
      "default": "גלו את המשמעות העמוקה הגלום בשמכם על פי חכמת הקבלה והגימטריה",
      "label": "טקסט גיבור"
    },
    { "type": "text", "id": "intro_title", "default": "הכוח של השם שלך", "label": "כותרת מבוא" },
    {
      "type": "textarea",
      "id": "intro_p",
      "label": "פסקת מבוא",
      "default": "לפי המסורת היהודית והקבלה, השם שלנו אינו רק זיהוי אלא נושא בתוכו את מהות הנשמה, הייעוד והפוטנציאל הגלום בנו. באמצעות חכמת הגימטריה והפירוש העמוק של האותיות, אנו יכולים לחשוף תובנות משמעותיות על האישיות, החוזקות, האתגרים והייעוד הרוחני של האדם."
    },
    {
      "type": "text",
      "id": "intro_quote",
      "label": "ציטוט",
      "default": "שם האדם אינו דבר מקרי, אלא ביטוי עמוק לשורש נשמתו ולתפקידו בעולם"
    },
    {
      "type": "text",
      "id": "form_title",
      "default": "מעוניינים בפיענוח שם אישי ומעמיק?",
      "label": "כותרת טופס"
    },
    {
      "type": "text",
      "id": "form_label",
      "default": "השאירו פרטים ואחזור אליכם עם פיענוח מלא ומשמעותי",
      "label": "תווית"
    },
    { "type": "text", "id": "form_placeholder", "default": "השם המלא שלך", "label": "Placeholder" },
    { "type": "text", "id": "form_btn", "default": "צרו קשר", "label": "טקסט כפתור" },
    { "type": "text", "id": "comp_title", "default": "מרכיבי הפיענוח", "label": "כותרת כרטיסים" },
    {
      "type": "text",
      "id": "wa_phone",
      "label": "וואטסאפ (מספר בלי +)",
      "default": "972533397827",
      "info": "למשל 972533397827 — יופיע בקישור wa.me"
    },
    {
      "type": "textarea",
      "id": "wa_msg_with_name",
      "label": "הודעת וואטסאפ כשהוזן שם",
      "default": "שלום, אשמח לקבל פיענוח שם בתשלום של 100 שקלים, לשם: {name}",
      "info": "חובה לכלול את המילה {name} — היא תוחלף בשם שהלקוח הזין."
    },
  ],
  "blocks": [
    {
      "type": "item",
      "name": "כרטיס",
      "settings": [
        { "type": "text", "id": "title", "label": "כותרת", "default": "גימטריה" },
        {
          "type": "textarea",
          "id": "text",
          "label": "תיאור",
          "default": "ערך מספרי של האותיות בשם, חושף את האנרגיה הכוללת והפוטנציאל הרוחני."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "פיענוח שמות",
      "blocks": [
        { "type": "item", "settings": { "title": "גימטריה", "text": "ערך מספרי של האותיות בשם, חושף את האנרגיה הכוללת והפוטנציאל הרוחני." } },
        { "type": "item", "settings": { "title": "משמעות האותיות", "text": "כל אות בשם נושאת אנרגיה ומשמעות ייחודית המשפיעה על האישיות והייעוד." } },
        { "type": "item", "settings": { "title": "ייעוד רוחני", "text": "חיבור בין המשמעויות השונות מאפשר הבנה עמוקה של הייעוד הרוחני והמסע הנשמתי." } }
      ]
    }
  ]
}
{% endschema %}
