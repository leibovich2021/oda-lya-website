<section id="crystal-landing" class="hero crystal-hero oda-crystals-hero">
  <div class="container">
    <div class="hero-content oda-crystals-hero__panel">
      <h1>{{ section.settings.hero_title }}</h1>
      <div class="intro-separator crystal-separator oda-crystals-hero__rule"></div>
      <p class="crystal-hero-text">{{ section.settings.hero_text }}</p>
    </div>
  </div>
</section>

<section id="crystal-therapy" class="oda-crystals-therapy">
  <div class="container">
    <div class="section-title oda-crystals-section-title">
      <h2>{{ section.settings.intro_title }}</h2>
    </div>
    <div class="content-box crystal-intro-box oda-crystals-glass">
      <p>{{ section.settings.intro_p1 }}</p>
      <div class="crystal-quote">
        <blockquote>{{ section.settings.intro_quote }}</blockquote>
      </div>
    </div>
  </div>
</section>

<section id="crystal-types" class="oda-crystals-types">
  <div class="container">
    <div class="section-title oda-crystals-section-title">
      <h2>{{ section.settings.grid_title }}</h2>
    </div>
    {% render 'crystals-grid-inner' %}
  </div>
</section>

<section id="crystal-benefits" class="benefit-section oda-crystals-benefits">
  <div class="container">
    <div class="section-title oda-crystals-section-title">
      <h2>{{ section.settings.benefits_title }}</h2>
    </div>
    <div class="benefits-grid oda-crystals-benefits-grid">
      {% for block in section.blocks %}
        {% if block.type == 'benefit' %}
          <div class="benefit-item oda-crystals-benefit-card" {{ block.shopify_attributes }}>
            <div class="benefit-icon"><i class="{{ block.settings.icon }}"></i></div>
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.text }}</p>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<section id="contact-crystal" class="contact-section-crystal oda-crystals-cta">
  <div class="container">
    <div class="contact-crystal-content oda-crystals-cta__panel">
      <h2>{{ section.settings.cta_title }}</h2>
      <p>{{ section.settings.cta_text }}</p>
      <a href="{{ section.settings.cta_url }}" class="btn contact-btn crystal-contact-btn oda-crystals-cta__btn">{{ section.settings.cta_label }}</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "עמוד קריסטלים (מלא)",
  "settings": [
    { "type": "text", "id": "hero_title", "label": "כותרת גיבור", "default": "רִפּוּי בִּקְרִיסְטָלִים" },
    {
      "type": "text",
      "id": "hero_text",
      "label": "טקסט גיבור",
      "default": "גלו את העוצמה המרפאה של אבני החן והקריסטלים במסורת היהודית"
    },
    { "type": "text", "id": "intro_title", "label": "כותרת מבוא", "default": "עוצמת הקריסטלים" },
    {
      "type": "textarea",
      "id": "intro_p1",
      "label": "פסקת מבוא",
      "default": "קריסטלים הם אוצרות טבעיים בעלי תכונות אנרגטיות ייחודיות. במסורת היהודית, אבני החושן שימשו ככלים מקודשים בעלי כוחות מיוחדים."
    },
    {
      "type": "text",
      "id": "intro_quote",
      "label": "ציטוט",
      "default": "אבני החן הן מתנות מהאדמה, המחברות אותנו לחכמה עתיקה ולכוחות הריפוי של הטבע"
    },
    { "type": "text", "id": "grid_title", "label": "כותרת רשת", "default": "סוגי הקריסטלים" },
    { "type": "text", "id": "benefits_title", "label": "כותרת יתרונות", "default": "היתרונות של עבודה עם קריסטלים" },
    { "type": "text", "id": "cta_title", "label": "כותרת CTA", "default": "מעוניינים בטיפול עם קריסטלים?" },
    { "type": "text", "id": "cta_text", "label": "טקסט CTA", "default": "השאירו פרטים ואחזור אליכם בהקדם" },
    { "type": "text", "id": "cta_label", "label": "טקסט כפתור", "default": "צרי קשר עכשיו" },
    { "type": "text", "id": "cta_url", "label": "קישור", "default": "/pages/contact" }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "יתרון",
      "settings": [
        { "type": "text", "id": "icon", "label": "Font Awesome class", "default": "fas fa-brain" },
        { "type": "text", "id": "title", "label": "כותרת", "default": "איזון רגשי" },
        {
          "type": "textarea",
          "id": "text",
          "label": "תיאור",
          "default": "קריסטלים מסייעים בהפחתת מתח, חרדה ובהשבת שלווה פנימית"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "עמוד קריסטלים",
      "blocks": [
        { "type": "benefit", "settings": { "icon": "fas fa-brain", "title": "איזון רגשי", "text": "קריסטלים מסייעים בהפחתת מתח, חרדה ובהשבת שלווה פנימית" } },
        { "type": "benefit", "settings": { "icon": "fas fa-heart", "title": "ריפוי רגשי", "text": "עזרה בשחרור טראומות רגשיות ובניית דפוסי חשיבה חיוביים" } },
        { "type": "benefit", "settings": { "icon": "fas fa-globe", "title": "חיבור רוחני", "text": "העמקת החיבור לעצמי הפנימי ולמימד הרוחני של החיים" } },
        { "type": "benefit", "settings": { "icon": "fas fa-shield-alt", "title": "הגנה אנרגטית", "text": "יצירת שדה מגן מפני אנרגיות שליליות וסביבה מזיקה" } }
      ]
    }
  ]
}
{% endschema %}
